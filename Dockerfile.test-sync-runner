FROM oven/bun:latest

# 同步专用镜像：FenixAgent 源码 diff + AgentTest 工作副本 + Claude Code CLI。
# 与 unit-runner / test-runner 完全隔离，避免影响已绿的 CI 环境。
ARG CLAUDE_CODE_VERSION=latest
ENV DEBIAN_FRONTEND=noninteractive

USER root

# apt 源按 阿里云 → 清华 → 官方 依次回退（国内服务器直连 deb.debian.org 常超时）
RUN set -eux; \
    SRC="$(ls /etc/apt/sources.list /etc/apt/sources.list.d/*.sources /etc/apt/sources.list.d/*.list 2>/dev/null || true)"; \
    for f in $SRC; do sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' "$f"; done; \
    if ! apt-get update; then \
      for f in $SRC; do sed -i 's|mirrors.aliyun.com|mirrors.tuna.tsinghua.edu.cn|g' "$f"; done; \
      if ! apt-get update; then \
        for f in $SRC; do sed -i 's|mirrors.tuna.tsinghua.edu.cn|deb.debian.org|g' "$f"; done; \
        apt-get update; \
      fi; \
    fi; \
    apt-get install -y --no-install-recommends \
      python3 python3-venv python3-pip git curl ca-certificates nodejs npm ripgrep; \
    rm -rf /var/lib/apt/lists/*

COPY requirements-test.txt /app/requirements-test.txt
# pip 源同样按 阿里云 → 清华 → 官方 回退
RUN python3 -m venv /opt/venv && set -eux; \
    for m in "https://mirrors.aliyun.com/pypi/simple" "https://pypi.tuna.tsinghua.edu.cn/simple" ""; do \
      if [ -n "$m" ]; then \
        host=$(echo "$m" | sed -E 's#^https?://([^/]+)/.*#\1#'); \
        /opt/venv/bin/pip install --no-cache-dir -i "$m" --trusted-host "$host" -r /app/requirements-test.txt && break; \
      else \
        /opt/venv/bin/pip install --no-cache-dir -r /app/requirements-test.txt && break; \
      fi; \
    done; \
    /opt/venv/bin/python -c "import pytest, yaml, jsonschema, playwright"
ENV PATH=/opt/venv/bin:/usr/local/bin:$PATH

# npm 源先走 npmmirror，失败回落官方
RUN set -eux; \
    npm config set registry https://registry.npmmirror.com; \
    npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} \
      || (npm config set registry https://registry.npmjs.org && npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}); \
    npm cache clean --force

# 挂载卷常由宿主 jenkins 用户写入，避免 git 报 dubious ownership
RUN git config --global --add safe.directory '*'

COPY entrypoint-test-sync.sh /app/entrypoint-test-sync.sh
RUN chmod +x /app/entrypoint-test-sync.sh

WORKDIR /repo
ENTRYPOINT ["/app/entrypoint-test-sync.sh"]
