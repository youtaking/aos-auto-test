FROM oven/bun:latest
WORKDIR /app

# 预装依赖缓存（构建时尝试安装，workspace:* 依赖会失败但没关系，
# 运行时 entrypoint 会从完整 workspace 结构正确安装并填充缓存）
RUN mkdir -p /app/cache/node_modules
COPY cache/package.json /app/cache/package.json
COPY cache/bun.lock* /app/cache/
RUN cd /app/cache && \
    (bun install --frozen-lockfile 2>&1 || \
     bun install 2>&1 || \
     echo "Build-time install failed (expected for workspace:* deps), will install at runtime") | tail -5

# Entrypoint
COPY entrypoint-unit.sh /app/entrypoint-unit.sh
RUN chmod +x /app/entrypoint-unit.sh

ENTRYPOINT ["/app/entrypoint-unit.sh"]
